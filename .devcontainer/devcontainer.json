{
  "name": "Rust Game Dev (DevContainer)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind",
    "source=rust-game-target-cache,target=${containerWorkspaceFolder}/target,type=volume",
    // agy の設定ディレクトリを Docker 領域に保持（vscode ユーザーの場合）
    "source=agy-config-vol,target=/home/vscode/.gemini/antigravity-cli,type=volume"
  ],
  "containerEnv": {
    "DISPLAY": ":0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "/mnt/wslg/PulseServer",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GTK_IM_MODULE": "fcitx",
    "QT_IM_MODULE": "fcitx",
    "XMODIFIERS": "@im=fcitx",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/dbus-session-vscode.sock"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "mkdir -p ~/.gemini/antigravity-cli && sudo chown -R $(whoami) ~/.gemini && curl -fsSL https://antigravity.google/cli/install.sh | bash",
  "postStartCommand": "bash .devcontainer/init-ime.sh"
}
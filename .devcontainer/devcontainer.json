{
  "name": "Rust Game Dev (DevContainer)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind",
    "source=rust-game-target-cache,target=${containerWorkspaceFolder}/target,type=volume",
    // agy の設定ディレクトリを Docker 領域に保持（vscode ユーザーの場合）
    "source=agy-config-vol,target=/home/vscode/.gemini/antigravity-cli,type=volume"
  ],
  "containerEnv": {
    "DISPLAY": ":0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "/mnt/wslg/PulseServer",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "mkdir -p ~/.gemini/antigravity-cli && sudo chown -R $(whoami) ~/.gemini && sudo apt update && sudo apt install -y fonts-ipafont-gothic && rustup target add x86_64-pc-windows-msvc && cargo install cargo-xwin && curl -fsSL https://antigravity.google/cli/install.sh | bash"
}